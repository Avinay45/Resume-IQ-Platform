# ResumeIQ Environment Variables Configuration
# Copy this file to .env and replace the values

# 1. Supabase Backend Integration (Optional)
# If left as blank or placeholder, ResumeIQ will auto-switch to "Local Sandbox Mode" (IndexedDB/LocalStorage)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. AI Providers Credentials (Optional)
# If empty, ResumeIQ runs a rule-based Local AI screening engine for local testing
VITE_GEMINI_API_KEY=your-google-gemini-api-key
VITE_OPENROUTER_API_KEY=your-openrouter-api-key

# 3. Email Delivery Credentials (Optional)
# If empty, emails will log to the console and database audit trail
VITE_RESEND_API_KEY=your-resend-api-key
